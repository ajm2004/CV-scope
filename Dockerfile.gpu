# CV-Scope, NVIDIA GPU image. Requires the NVIDIA Container Toolkit on the host.
# Build:  docker build -f Dockerfile.gpu -t cv-scope:cuda .
# Run:    docker run --gpus all -p 8420:8420 -v cvscope-data:/app/data cv-scope:cuda

FROM node:22-alpine AS frontend
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY frontend/ ./
# The in-app guides are bundled from docs/guides
COPY docs/guides /build/docs/guides
RUN npm run build

FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04 AS runtime
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive \
    PATHSCOPE_HOST=0.0.0.0 \
    PATHSCOPE_PORT=8420 \
    PATHSCOPE_DATA_DIR=/app/data \
    PATHSCOPE_DEVICE=auto \
    PATHSCOPE_CORS_ORIGINS=http://localhost:8420,http://127.0.0.1:8420
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 ffmpeg curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/local/bin/python
WORKDIR /app
COPY backend/pyproject.toml backend/README.md backend/alembic.ini /app/backend/
COPY backend/alembic /app/backend/alembic
COPY backend/pathscope /app/backend/pathscope
# Ubuntu 24.04 marks the system Python as externally managed, so install into a venv
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install torch torchvision --index-url https://download.pytorch.org/whl/cu126 \
    && /opt/venv/bin/pip install -e "/app/backend[ultralytics,onnx-gpu,export,postgres]"
ENV PATH="/opt/venv/bin:$PATH"
COPY --from=frontend /build/frontend/dist /app/frontend/dist
COPY README.md /app/README.md
VOLUME ["/app/data"]
EXPOSE 8420
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s CMD curl -fs http://127.0.0.1:8420/api/system/status || exit 1
CMD ["cvscope", "serve"]
