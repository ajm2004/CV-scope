# CV-Scope configuration. Copy to .env and adjust. Every value is optional;
# the defaults give a single-machine, SQLite-backed install.

# ---- Storage ---------------------------------------------------------------
# Root directory for the local database, uploaded videos, model weights, exports.
PATHSCOPE_DATA_DIR=./data

# SQLAlchemy database URL. SQLite is the default. For PostgreSQL use e.g.
# postgresql+psycopg://pathscope:pathscope@localhost:5432/pathscope
# PATHSCOPE_DATABASE_URL=sqlite:///./data/pathscope.db

# ---- Server ----------------------------------------------------------------
PATHSCOPE_HOST=127.0.0.1
PATHSCOPE_PORT=8420
# Comma separated origins allowed to call the API (the Vite dev server by default).
PATHSCOPE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Inference -------------------------------------------------------------
# auto | cpu | cuda | cuda:0 | mps
PATHSCOPE_DEVICE=auto
# Directory where detector weights are stored (defaults to <DATA_DIR>/models).
# PATHSCOPE_MODELS_DIR=./data/models

# ---- Retention / privacy ---------------------------------------------------
# Store sampled trajectories for every track (needed for trajectory review/heatmaps).
PATHSCOPE_STORE_TRAJECTORIES=true
# Keep uploaded source videos after a run finishes.
PATHSCOPE_KEEP_SOURCE_VIDEO=true
# Days to keep events/trajectories (0 = keep forever).
PATHSCOPE_RETENTION_DAYS=0

# ---- Logging ---------------------------------------------------------------
# debug | info | warning | error
PATHSCOPE_LOG_LEVEL=info
# json | console
PATHSCOPE_LOG_FORMAT=console

# ---- Licensed recognition modules (see docs/recognition.md) -----------------
# Comma-separated hex Ed25519 public keys of the licence issuers this
# installation trusts. Empty (the open-source default) keeps face and plate
# recognition locked; a vendor build sets its key here. Never a secret.
# PATHSCOPE_RECOGNITION_ISSUER_KEYS=
# Where the encryption keys of biometric templates and enrollment media live
# (defaults to <DATA_DIR>/recognition/keys; put them on another volume to
# separate keys from data).
# PATHSCOPE_RECOGNITION_KEY_DIR=
